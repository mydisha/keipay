# KeiPay configuration.
#
# Copy to .env at the repository root. `make dev` and the backend commands
# read it from there; `docker compose` reads it for variable substitution.
# Process environment variables always win over this file.

# Server. `make dev` / `make backend` run the API on HTTP_PORT.
APP_ENV=development
HTTP_PORT=8080
HTTP_BASE_URL=http://localhost:8080

# Admin console dev server (`make dev` / `make frontend`). It proxies the API
# on HTTP_PORT.
UI_PORT=5173

# Logging
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: json | console. Leave empty to auto-pick (json in production, console otherwise)
LOG_FORMAT=

# Graceful shutdown
# Should be longer than your longest request and match your load balancer's drain timeout
SHUTDOWN_TIMEOUT=30s

# Postgres (matches the postgres service in compose.yaml)
POSTGRES_DSN=postgres://keipay:keipay@localhost:5432/keipay?sslmode=disable

# Redis: cache, idempotency, asynq broker
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Gateway accounts are connections, added in the console (Connections).
# Deprecated: XENDIT_SECRET_KEY and XENDIT_CALLBACK_TOKEN are imported once
# into a connection named xendit-imported (set both or neither), then ignored.
# Keep them only for the first start after upgrading, then remove them.
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=

# Admin console sessions live in Redis; nothing to generate.
# COOKIE_SECURE: auto (Secure cookies unless APP_ENV=development) | true | false.
# Browsers accept Secure cookies on http://localhost; set false only when the
# console is served over plain http on another host.
COOKIE_SECURE=auto
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
# Failed sign-ins allowed per client IP and per email within the window.
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_FAILURE_WINDOW=15m
# Comma-separated proxy IPs or CIDRs whose X-Forwarded-For is trusted for the
# client IP (rate limits, audit log). Empty trusts none: the TCP peer is the
# client. Behind a reverse proxy, list it here, e.g. 127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
# Optional. When set, first-run setup in the console asks for this value.
# Set it if others can reach the console before you create the first owner.
SETUP_TOKEN=

# AES-256-GCM key for encrypting app secrets at rest (64 hex chars / 32 bytes).
# Generate with: openssl rand -hex 32. Losing it makes stored secrets unrecoverable.
ENCRYPTION_KEY=

# Worker
RUN_WORKER=true
# Disable a webhook endpoint after this many deliveries in a row ran out of
# attempts (0 never disables). Retries per delivery are set per endpoint;
# WEBHOOK_MAX_RETRY is no longer read.
WEBHOOK_DISABLE_AFTER_FAILURES=5

# Admin console build to serve. Leave empty to auto-detect frontend/dist.
FRONTEND_DIR=

# docker compose host ports. Keep POSTGRES_DSN and REDIS_ADDR above in sync;
# `make setup POSTGRES_PORT=... REDIS_PORT=...` writes both for you.
KEIPAY_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
